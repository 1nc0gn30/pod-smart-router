#!/usr/bin/env python3
"""
POD Smart Router Executable Entrypoint
"""

# zothos-repo-shim: run the canonical repo copy so repo-relative paths resolve
import os as _os, sys as _sys
_here = _os.path.realpath(__file__)
_repo = _os.environ.get("ZOTH_REPO_DIR") or '/home/zoth/NullAITech' + "/" + 'pod-smart-router'
_real = _os.path.join(_repo, "bin", 'pod-smart-router')
if _os.path.exists(_real) and _os.path.realpath(_real) != _here:
    _os.execv(_sys.executable, [_sys.executable, _real] + _sys.argv[1:])
del _os, _sys, _here, _repo, _real

import sys
import os

# Add src to pythonpath
src_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "src"))
if src_dir not in sys.path:
    sys.path.insert(0, src_dir)

from pod_smart_router.cli import main

if __name__ == "__main__":
    main()
